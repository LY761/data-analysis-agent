# ===== LLM（OpenAI 兼容接口，默认 DeepSeek） =====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=gpt-4o-mini

# ===== 数据库 =====
DB_TYPE=sqlite                 # sqlite | mysql
MYSQL_URL=                     # mysql://user:pass@host:3306/dbname
DEMO_DB_PATH=./demo_sales.db

# ===== 向量库 =====
VECTOR_STORE=chromadb          # chromadb | milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== 本地嵌入模型 =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== 功能开关 =====
WEB_SEARCH_ENABLED=true        # 知识类问题联网搜索
NL_ANSWER_LLM=true             # 查询结果 LLM 口语化回答
AUTH_ENABLED=false             # JWT 认证
AUTH_JWT_SECRET=

# ===== 其他 =====
COMPETITOR_SCRAPER_PATH=C:/Users/LY/competitor-scraper
