# ===== LLM（OpenAI 兼容接口，默认 DeepSeek） =====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ===== 服务 =====
APP_ENV=demo                    # demo | production
HOST=0.0.0.0
PORT=8100
CORS_ORIGINS=http://127.0.0.1:8100,http://localhost:8100

# ===== 数据库 =====
DB_TYPE=sqlite                 # sqlite | mysql
MYSQL_URL=                     # mysql://user:pass@host:3306/dbname
DEMO_DB_PATH=./demo_sales.db
STANDARD_DATA_DB_PATH=./data/standard_ecommerce.db

# ===== 向量库 =====
VECTOR_STORE=chromadb          # chromadb | milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== 本地嵌入模型 =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BACKEND=sentence_transformer  # CI/离线可设 hashing，避免下载模型
EMBEDDING_DIMENSION=384

# ===== 功能开关 =====
NL_ANSWER_LLM=false             # 查询结果 LLM 口语化回答
AUTH_ENABLED=false             # JWT 认证
JWT_SECRET=
INTEGRATION_TOKEN=

# ===== MCP（默认仅本机监听） =====
MCP_TRANSPORT=streamable-http  # streamable-http | stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
